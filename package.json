{
  "name": "automatorr-compare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Automatorr — head-to-head PC component comparison tool",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspace shared && npm run build --workspace server && npm run build --workspace client",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "test": "npm run test --workspace shared --if-present && npm run test --workspace server --if-present && npm run test --workspace client --if-present",
    "seed": "npm run seed --workspace server",
    "scrape": "npm run scrape --workspace server",
    "rollups": "npm run rollups --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.20.0",
    "mongoose": "^9.7.0",
    "multer": "^2.2.0",
    "nodemon": "^3.1.14",
    "react-router-dom": "^7.18.0"
  },
  "main": "eslint.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stalebiscuit/AutomatorrPC.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/stalebiscuit/AutomatorrPC/issues"
  },
  "homepage": "https://github.com/stalebiscuit/AutomatorrPC#readme"
}
