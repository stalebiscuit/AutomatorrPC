# Speccify server env template — PROD VM ENVIRONMENT (speccify.info).
# On the VM, copy to `.env.production` and fill in real secrets. Loaded when NODE_ENV=production.

NODE_ENV=production

# ─── Server / database ───────────────────────────────────────────────
# Separate database name from test; same mongod instance is fine (localhost).
MONGO_URI=mongodb://speccify_app:CHANGE_ME@127.0.0.1:27017/speccify_prod?authSource=speccify_prod
# Prod backend binds to its own localhost port; Nginx proxies speccify.info here.
PORT=8102
CLIENT_URL=https://speccify.info
APP_URL=https://speccify.info

# ─── Admin auth ──────────────────────────────────────────────────────
# OTP email delivery. Choose ONE provider:
#   graph   — Microsoft Graph sendMail (recommended; set GRAPH_* below)
#   smtp    — nodemailer (set SMTP_* below)
#   console — codes print to the server log (no email)
MAILER_PROVIDER=graph
SUPERADMIN_EMAILS=daniel.hardman@automatorr.com,abishai.bajaj@automatorr.com
OTP_FROM=AI@Automatorr.com
OTP_FROM_NAME=Speccify

# Microsoft Graph (MAILER_PROVIDER=graph) — from your app registration.
# App needs the APPLICATION permission Mail.Send, admin-consented. OTP_FROM is
# the sender mailbox the app is authorised to send as.
GRAPH_TENANT_ID=CHANGE_ME
GRAPH_CLIENT_ID=CHANGE_ME
GRAPH_CLIENT_SECRET=CHANGE_ME

# SMTP (only if MAILER_PROVIDER=smtp)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=AI@Automatorr.com
SMTP_PASS=CHANGE_ME
# Auth signing (REQUIRED in production — config validation fails without one of these):
# preferred: RS256 keypair from `npm run generate-keys --workspace server` (base64 PEM).
ADMIN_JWT_PRIVATE_KEY=
ADMIN_JWT_PUBLIC_KEY=
# fallback: a strong random secret if you deliberately choose HS256 instead of a keypair.
JWT_SECRET=

# ─── Provider seams ──────────────────────────────────────────────────
PRICE_PROVIDER=scraper
VERDICT_PROVIDER=placeholder

# ─── Schedulers ──────────────────────────────────────────────────────
SCRAPE_CRON=15 3 * * *
SCRAPE_USER_AGENT=AutomatorrPriceBot/1.0 (+https://automatorr.com/bot)
ROLLUP_CRON=0 * * * *
CATALOG_INGEST_CRON=30 4 * * *

# ─── Catalogue enrichment (optional) ─────────────────────────────────
ICECAT_USERNAME=
ICECAT_API_TOKEN=
