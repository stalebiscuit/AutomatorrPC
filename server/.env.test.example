# Speccify server env template — TEST VM ENVIRONMENT (test.speccify.info).
# On the VM, copy to `.env.test` and fill in real secrets. Loaded when NODE_ENV=test.
# This is the PERSISTENT Test environment DB — NOT the pipeline's ephemeral e2e DB.

NODE_ENV=test

# ─── Server / database ───────────────────────────────────────────────
# Separate database name from prod; same mongod instance is fine (localhost).
MONGO_URI=mongodb://speccify_app:CHANGE_ME@127.0.0.1:27017/speccify_test?authSource=speccify_test
# Test backend binds to its own localhost port; Nginx proxies test.speccify.info here.
PORT=8101
CLIENT_URL=https://test.speccify.info
APP_URL=https://test.speccify.info

# ─── Admin auth ──────────────────────────────────────────────────────
MAILER_PROVIDER=smtp
SUPERADMIN_EMAILS=daniel.hardman@automatorr.com,abishai.bajaj@automatorr.com
OTP_FROM=AI@Automatorr.com
OTP_FROM_NAME=Speccify (Test)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=AI@Automatorr.com
SMTP_PASS=CHANGE_ME
# Auth signing — set EITHER an RS256 keypair (preferred) OR a JWT_SECRET fallback.
JWT_SECRET=
ADMIN_JWT_PRIVATE_KEY=
ADMIN_JWT_PUBLIC_KEY=

# ─── Provider seams ──────────────────────────────────────────────────
PRICE_PROVIDER=scraper
VERDICT_PROVIDER=placeholder

# ─── Schedulers ──────────────────────────────────────────────────────
SCRAPE_CRON=15 3 * * *
SCRAPE_USER_AGENT=AutomatorrPriceBot/1.0 (+https://automatorr.com/bot)
ROLLUP_CRON=0 * * * *
CATALOG_INGEST_CRON=30 4 * * *

# ─── Catalogue enrichment (optional) ─────────────────────────────────
ICECAT_USERNAME=
ICECAT_API_TOKEN=
