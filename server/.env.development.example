# Speccify server env template — LOCAL DEVELOPMENT.
# Copy to `.env.development` and fill in. Loaded when NODE_ENV=development.

NODE_ENV=development

# ─── Server / database ───────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/speccify
PORT=4000
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# ─── Admin auth (passwordless email-OTP) ─────────────────────────────
MAILER_PROVIDER=console
SUPERADMIN_EMAILS=daniel.hardman@automatorr.com,abishai.bajaj@automatorr.com
OTP_FROM=AI@Automatorr.com
# Auth signing — leave all blank in dev to auto-generate an ephemeral RS256 keypair.
# Set JWT_SECRET for an HS256 shared-secret setup, OR the RS256 keypair below.
JWT_SECRET=
ADMIN_JWT_PRIVATE_KEY=
ADMIN_JWT_PUBLIC_KEY=

# ─── Provider seams ──────────────────────────────────────────────────
PRICE_PROVIDER=scraper
VERDICT_PROVIDER=placeholder

# ─── Schedulers ──────────────────────────────────────────────────────
SCRAPE_CRON=15 3 * * *
SCRAPE_USER_AGENT=AutomatorrPriceBot/1.0 (+https://automatorr.com/bot)
ROLLUP_CRON=0 * * * *
CATALOG_INGEST_CRON=30 4 * * *

# ─── Catalogue enrichment (optional) ─────────────────────────────────
ICECAT_USERNAME=
ICECAT_API_TOKEN=
