# ─── Server / database ───────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/automatorr
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ─── Admin auth ──────────────────────────────────────────────────────
# Generate a strong secret, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
# bcrypt hash of the admin password.
# Generate with: npm run hash-password --workspace server -- "your-password"
ADMIN_PASSWORD_HASH=$2b$10$replace.this.with.a.real.bcrypt.hash.value.000000000000

# ─── Provider seams (swappable via config) ───────────────────────────
PRICE_PROVIDER=scraper
VERDICT_PROVIDER=placeholder

# ─── Scraper ─────────────────────────────────────────────────────────
# Nightly at 03:15 by default
SCRAPE_CRON=15 3 * * *
SCRAPE_USER_AGENT=AutomatorrPriceBot/1.0 (+https://automatorr.com/bot)

# ─── Analytics rollups ───────────────────────────────────────────────
# Hourly rollup aggregation
ROLLUP_CRON=0 * * * *

# ─── Claude verdict provider (wired in a later version) ──────────────
# ANTHROPIC_API_KEY=
# VERDICT_MODEL=claude-haiku-4-5-20251001

# ─── Task 3: catalogue data sources (see docs/task3-credentials-checklist.md) ──
# Put real values in server/.env (git-ignored). All optional until wired.
# Icecat (specs)
# ICECAT_USERNAME=
# ICECAT_API_TOKEN=
# ICECAT_APP_KEY=   # Full Icecat (paid) — for brand-restricted products
# Amazon Product Advertising API (Amazon AU prices)
# AMAZON_PAAPI_ACCESS_KEY=
# AMAZON_PAAPI_SECRET_KEY=
# AMAZON_PARTNER_TAG=
# AMAZON_PAAPI_HOST=webservices.amazon.com.au
# AMAZON_PAAPI_REGION=us-west-2
# PassMark (performance index) — licensed data file
# PASSMARK_DATA_PATH=
# Retailer affiliate tags (Buy-link monetization)
# MWAVE_AFFILIATE_TAG=
# SCORPTEC_AFFILIATE_TAG=
# CENTRECOM_AFFILIATE_TAG=
# PLE_AFFILIATE_TAG=
# PCCG_AFFILIATE_TAG=

# ─── Task 3: retailer product feeds (see docs/task3-affiliate-feeds-guide.md) ──
# Per-retailer product feed URL + affiliate tracking id. All optional until wired.
# MWAVE_FEED_URL=
# MWAVE_AFFILIATE_ID=
# SCORPTEC_FEED_URL=
# SCORPTEC_AFFILIATE_ID=
# CENTRECOM_FEED_URL=
# CENTRECOM_AFFILIATE_ID=
# PLE_FEED_URL=
# PLE_AFFILIATE_ID=
# PCCG_FEED_URL=
# PCCG_AFFILIATE_ID=
# AFFILIATE_NETWORK_API_KEY=
