# ─── Server / database ───────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/automatorr
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ─── Admin auth ──────────────────────────────────────────────────────
# Generate a strong secret, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
# bcrypt hash of the admin password.
# Generate with: npm run hash-password --workspace server -- "your-password"
ADMIN_PASSWORD_HASH=$2b$10$replace.this.with.a.real.bcrypt.hash.value.000000000000

# ─── Provider seams (swappable via config) ───────────────────────────
PRICE_PROVIDER=scraper
VERDICT_PROVIDER=placeholder

# ─── Scraper ─────────────────────────────────────────────────────────
# Nightly at 03:15 by default
SCRAPE_CRON=15 3 * * *
SCRAPE_USER_AGENT=AutomatorrPriceBot/1.0 (+https://automatorr.com/bot)

# ─── Analytics rollups ───────────────────────────────────────────────
# Hourly rollup aggregation
ROLLUP_CRON=0 * * * *

# ─── Claude verdict provider (wired in a later version) ──────────────
# ANTHROPIC_API_KEY=
# VERDICT_MODEL=claude-haiku-4-5-20251001
