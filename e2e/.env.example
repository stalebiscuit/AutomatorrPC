# Speccify E2E + Azure DevOps integration — template. Copy to `e2e/.env` (gitignored).
#
# The PAT is the only real secret. Regenerating a PAT's scopes ROTATES ITS VALUE —
# every time that happens you MUST update BOTH this file AND the pipeline's
# AZURE_DEVOPS_PAT secret variable together, or CI silently fails auth while local
# calls keep working.

# ─── Azure DevOps ────────────────────────────────────────────────────
# PAT scopes: Work Items (Read & Write), Test Management (Read & Write), Build (Read & Execute).
AZURE_DEVOPS_PAT=
AZDO_ORG_URL=https://dev.azure.com/automatorr
AZDO_PROJECT=AutomatorrSpeccify
AZDO_PLAN_NAME=Speccify Regression
# Board work-item type the coverage gate treats as a ticket (Speccify uses Tasks).
AZDO_TICKET_TYPE=Task

# ─── E2E run target ──────────────────────────────────────────────────
# App under test (single-process origin serving client + /api). Locally, point
# at the Vite dev server (5173) for UI tests or the API server (4000) for API-only.
E2E_BASE_URL=http://127.0.0.1:4000
# Ephemeral throwaway DB — the wipe guard REQUIRES an *e2e*/*ci* name on localhost.
E2E_MONGO_URI=mongodb://127.0.0.1:27017/speccify_e2e
# Enables the server's POST /api/test/login hook (never set this in production).
E2E_TEST_HOOKS=true
# A seeded, eligible super-admin used by the auth smoke test.
E2E_ADMIN_EMAIL=daniel.hardman@automatorr.com

# Emergency coverage-gate override (leave false; logs loudly when true).
AZDO_GATE_SKIP=false
